# Copy to .env.local (never committed) and fill in.
# Real values also go in Vercel → Project → Settings → Environment Variables,
# with a separate database (Neon branch) and secret for Preview and Production.

# Neon Postgres connection string (pooled). The app reads this one.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Neon direct (unpooled) connection string, used only by `npm run db:migrate`.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Better Auth. Signs session cookies: generate one per environment with
# `openssl rand -base64 32` and never reuse it between them.
BETTER_AUTH_SECRET=
# The address the app is served from. Vercel previews may leave it unset.
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (optional; set both or neither). Redirect URI to register in
# Google Cloud: {BETTER_AUTH_URL}/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Email through Resend: sign-in links, invites and the 9:00 paper.
# EMAIL_FROM's domain must be verified in Resend, or it can only email you.
# Without these, development prints emails to the server log instead.
# RESEND_API_KEY=
# EMAIL_FROM="Pen & Paper <hello@yourdomain.com>"

# Shown on /privacy as the contact address (optional).
# SUPPORT_EMAIL=
