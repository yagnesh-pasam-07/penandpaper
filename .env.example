# Copy to .env.local (never committed) and fill in.
# Real values also go in Vercel → Project → Settings → Environment Variables,
# with a separate database (Neon branch) and secret for Preview and Production.

# Neon Postgres connection string (pooled). The app reads this one.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Neon direct (unpooled) connection string, used only by `npm run db:migrate`.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Better Auth. Signs session cookies: generate one per environment with
# `openssl rand -base64 32` and never reuse it between them.
BETTER_AUTH_SECRET=
# The address the app is served from. Vercel previews may leave it unset.
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (optional; set both or neither). Redirect URI to register in
# Google Cloud: {BETTER_AUTH_URL}/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Sign in with Apple (optional; set all four or none). Apple Developer →
# Identifiers → a Services ID (that is APPLE_CLIENT_ID) with "Sign in with
# Apple" on, domain + return URL {BETTER_AUTH_URL}/api/auth/callback/apple
# (https only, so not localhost). Keys → a key with Sign in with Apple: its id,
# your Team ID, and the .p8 file's text (newlines as \n is fine).
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Sign in with Microsoft (optional; set both or neither). Azure portal →
# App registrations → New, "Accounts in any organizational directory and
# personal Microsoft accounts", Web redirect URI
# {BETTER_AUTH_URL}/api/auth/callback/microsoft, then Certificates & secrets.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# Email through Resend: sign-in links, invites and the 9:00 paper.
# EMAIL_FROM's domain must be verified in Resend, or it can only email you.
# Without these, development prints emails to the server log instead.
# RESEND_API_KEY=
# EMAIL_FROM="Pen & Paper <hello@yourdomain.com>"

# Shown on /privacy as the contact address (optional).
# SUPPORT_EMAIL=

# Drop's 9 PM email: Vercel Cron calls /api/cron/drop-digest with this as a
# Bearer token. Generate with `openssl rand -hex 24`.
CRON_SECRET=
# Day boundaries for Drop papers and the 9 PM email (default Asia/Kolkata).
# DROP_TIMEZONE=Asia/Kolkata

# Voice (the mic button, and the Mac app): OpenAI speech-to-text. Leave empty to turn voice off.
OPENAI_API_KEY=

# /studio (analytics): only an account with role "admin" can open it, and only
# after typing this passcode. Never commit it. Unset, Studio is switched off.
# Make someone admin with: npm run set-role -- you@example.com admin
# STUDIO_PASSCODE=
