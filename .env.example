# Copy to .env.local (never committed) and fill in.
# Real values also go in Vercel → Project → Settings → Environment Variables.

# Neon Postgres connection string (pooled). The app reads this one.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Neon direct (unpooled) connection string, used only by `npm run db:migrate`.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
